// ===== LEVEL 47: long precision stepping-stone spike crossing =====
levels = levels + [mkLevel("47: Precision Crossing",
    platform(0.0, GROUND_Y - 20.0, 120.0) +
    spikeRow(0.0, 28, 40.0, GROUND_Y + 60.0) +
    platform(180.0, GROUND_Y - 20.0, 50.0) +
    platform(300.0, GROUND_Y - 80.0, 50.0) +
    platform(420.0, GROUND_Y - 20.0, 50.0) +
    platform(540.0, GROUND_Y - 140.0, 50.0) +
    platform(660.0, GROUND_Y - 20.0, 50.0) +
    [moving(760.0, GROUND_Y - 100.0, 90.0, 20.0, "x", 100.0, 1.4)] +
    platform(980.0, GROUND_Y - 20.0, 160.0) +
    [win(1040.0, GROUND_Y - 80.0, 40.0, 60.0)],
    40.0, GROUND_Y - 20.0 - PLAYER_H)];

// ===== LEVEL 48: bounce-elevator-spike combo tower =====
levels = levels + [mkLevel("48: Combo Tower",
    groundRow(0.0, 160.0, GROUND_Y, 80.0) +
    [bounce(100.0, GROUND_Y - 20.0, 50.0, 20.0)] +
    spikeRow(220.0, 4, 34.0, GROUND_Y) +
    platform(380.0, GROUND_Y - 40.0, 100.0) +
    [moving(500.0, GROUND_Y - 40.0, 90.0, 20.0, "y", 220.0, 1.0)] +
    platform(650.0, GROUND_Y - 300.0, 90.0) +
    spikeRow(670.0, 1, 40.0, GROUND_Y - 300.0) +
    [bounce(760.0, GROUND_Y - 320.0, 50.0, 20.0)] +
    platform(880.0, GROUND_Y - 520.0, 200.0) +
    [coin(960.0, GROUND_Y - 560.0, 20.0, 20.0)] +
    [win(980.0, GROUND_Y - 580.0, 40.0, 60.0)],
    40.0, GROUND_Y - PLAYER_H)];

// ===== LEVEL 49: everything, long and unforgiving =====
levels = levels + [mkLevel("49: Trial by Fire",
    groundRow(0.0, 150.0, GROUND_Y, 80.0) +
    spikeRow(150.0, 1, 34.0, GROUND_Y) +
    [moving(230.0, GROUND_Y - 20.0, 90.0, 20.0, "x", 130.0, 1.5)] +
    groundRow(500.0, 560.0, GROUND_Y, 80.0) +
    [bounce(520.0, GROUND_Y - 20.0, 60.0, 20.0)] +
    platform(650.0, GROUND_Y - 220.0, 100.0) +
    spikeRow(670.0, 2, 34.0, GROUND_Y - 220.0) +
    [moving(800.0, GROUND_Y - 260.0, 90.0, 20.0, "y", 160.0, 1.1)] +
    platform(950.0, GROUND_Y - 440.0, 90.0) +
    spikeRow(970.0, 1, 34.0, GROUND_Y - 440.0) +
    [moving(1100.0, GROUND_Y - 440.0, 90.0, 20.0, "x", 140.0, 1.6)] +
    platform(1320.0, GROUND_Y - 560.0, 180.0) +
    [coin(1400.0, GROUND_Y - 600.0, 20.0, 20.0)] +
    [win(1420.0, GROUND_Y - 620.0, 40.0, 60.0)],
    40.0, GROUND_Y - PLAYER_H)];

// ===== LEVEL 50: the finale =====
levels = levels + [mkLevel("50: Finale",
    groundRow(0.0, 160.0, GROUND_Y, 80.0) +
    spikeRow(160.0, 5, 32.0, GROUND_Y) +
    [moving(160.0, GROUND_Y - 20.0, 100.0, 20.0, "x", 230.0, 1.7)] +
    groundRow(600.0, 680.0, GROUND_Y, 80.0) +
    [bounce(620.0, GROUND_Y - 20.0, 60.0, 20.0)] +
    spikeRow(760.0, 5, 32.0, GROUND_Y) +
    platform(760.0, GROUND_Y - 260.0, 200.0) +
    spikeRow(800.0, 2, 34.0, GROUND_Y - 260.0) +
    [moving(1000.0, GROUND_Y - 300.0, 90.0, 20.0, "y", 180.0, 1.0)] +
    platform(1200.0, GROUND_Y - 480.0, 130.0) +
    [bounce(1230.0, GROUND_Y - 500.0, 50.0, 20.0)] +
    spikeRow(1400.0, 4, 32.0, GROUND_Y - 480.0) +
    platform(1400.0, GROUND_Y - 680.0, 260.0) +
    [moving(1700.0, GROUND_Y - 680.0, 90.0, 20.0, "x", 100.0, 1.4)] +
    platform(1900.0, GROUND_Y - 780.0, 200.0) +
    [coin(1970.0, GROUND_Y - 820.0, 20.0, 20.0)] +
    [win(1990.0, GROUND_Y - 840.0, 40.0, 60.0)],
    40.0, GROUND_Y - PLAYER_H)];

// ---------- game state ----------
let levelIndex = 0;
let score = 0;
let blocks = levels[levelIndex].blocks;
let px = levels[levelIndex].spawn[0];
let py = levels[levelIndex].spawn[1];
let vx = 0.0;
let vy = 0.0;
let onGround = false;
let standingOn = null;  // block ref currently supporting the player (for moving-platform carry)
let camX = 0.0;
let levelComplete = false;
let completeTimer = 0.0;
let allDone = false;
let collectedCoins = [];  // list of block references already collected (avoid double count)

fn loadLevel(idx) {
    levelIndex = idx;
    blocks = levels[levelIndex].blocks;
    px = levels[levelIndex].spawn[0];
    py = levels[levelIndex].spawn[1];
    vx = 0.0;
    vy = 0.0;
    onGround = false;
    standingOn = null;
    levelComplete = false;
    completeTimer = 0.0;
    collectedCoins = [];
    return null;
}

fn respawn() {
    px = levels[levelIndex].spawn[0];
    py = levels[levelIndex].spawn[1];
    vx = 0.0;
    vy = 0.0;
    onGround = false;
    standingOn = null;
    return null;
}

// ---------- AABB overlap test ----------
fn aabbOverlap(ax, ay, aw, ah, bx, by, bw, bh) {
    if (ax + aw <= bx) { return false; }
    if (ax >= bx + bw) { return false; }
    if (ay + ah <= by) { return false; }
    if (ay >= by + bh) { return false; }
    return true;
}

// ---------- coin identity helper (compare by position since coins don't move) ----------
fn coinAlreadyCollected(c) {
    let i = 0;
    while (i < len(collectedCoins)) {
        let cc = collectedCoins[i];
        if (cc[0] == c.x && cc[1] == c.y) { return true; }
        i = i + 1;
    }
    return false;
}

// ---------- main loop ----------
let running = true;
while (running) {
    if (pygame_poll_quit()) { running = false; }
    if (pygame_key("escape")) { running = false; }

    let dtMs = pygame_tick(60);
    let dt = dtMs / 1000.0;
    if (dt > 0.033) { dt = 0.033; }

    if (pygame_key("r")) { respawn(); }

    // ---- update moving platforms (always animate, even mid-level-complete) ----
    let mi = 0;
    while (mi < len(blocks)) {
        let b = blocks[mi];
        if (b.type == "moving") {
            b.prevX = b.x;
            b.prevY = b.y;
            b.phase = b.phase + b.speed * dt;
            let offset = sin(b.phase) * b.range;
            if (b.axis == "x") {
                b.x = b.homeX + offset;
            } else {
                b.y = b.homeY + offset;
            }
        }
        mi = mi + 1;
    }

    if (!allDone) {
        if (!levelComplete) {
            // ---- horizontal input ----
            vx = 0.0;
            if (pygame_key("a") || pygame_key("left"))  { vx = vx - MOVE_SPEED; }
            if (pygame_key("d") || pygame_key("right")) { vx = vx + MOVE_SPEED; }

            // find the platform we were standing on LAST frame (using the
            // standingOn reference set by last frame's collision, not a
            // fresh proximity guess) and apply its frame-delta directly to
            // the player's position first, as if the ground itself shifted.
            // This keeps the carry decoupled from this frame's gravity/jump
            // math, which is what was causing the elevator teleport.
            if (onGround && standingOn != null && standingOn.type == "moving") {
                let dx = standingOn.x - standingOn.prevX;
                let dy = standingOn.y - standingOn.prevY;
                px = px + dx;
                py = py + dy;
            }

            // ---- jump ----
            if ((pygame_key("space") || pygame_key("up")) && onGround) {
                vy = -JUMP_SPEED;
                onGround = false;
                standingOn = null;
            }

            // ---- gravity ----
            vy = vy + GRAVITY * dt;
            if (vy > MAX_FALL) { vy = MAX_FALL; }

            // ---- move X, resolve collisions ----
            let newX = px + vx * dt;
            let xi = 0;
            while (xi < len(blocks)) {
                let b = blocks[xi];
                if (b.type == "wall" || b.type == "moving") {
                    if (aabbOverlap(newX, py, PLAYER_W, PLAYER_H, b.x, b.y, b.w, b.h)) {
                        if (vx > 0.0) { newX = b.x - PLAYER_W; }
                        if (vx < 0.0) { newX = b.x + b.w; }
                    }
                }
                xi = xi + 1;
            }
            px = newX;

            // ---- move Y, resolve collisions ----
            let newY = py + vy * dt;
            onGround = false;
            standingOn = null;
            let yi = 0;
            while (yi < len(blocks)) {
                let b = blocks[yi];
                if (b.type == "wall" || b.type == "moving") {
                    if (aabbOverlap(px, newY, PLAYER_W, PLAYER_H, b.x, b.y, b.w, b.h)) {
                        if (vy > 0.0) {
                            newY = b.y - PLAYER_H;
                            onGround = true;
                            standingOn = b;
                            vy = 0.0;
                        } else if (vy < 0.0) {
                            newY = b.y + b.h;
                            vy = 0.0;
                        }
                    }
                }
                yi = yi + 1;
            }
            py = newY;

            // ---- hazards / coins / win ----
            let hk = 0;
            while (hk < len(blocks)) {
                let b = blocks[hk];
                if (aabbOverlap(px, py, PLAYER_W, PLAYER_H, b.x, b.y, b.w, b.h)) {
                    if (b.type == "spike") {
                        respawn();
                    } else if (b.type == "bounce") {
                        vy = -BOUNCE_SPEED;
                        onGround = false;
                    } else if (b.type == "win") {
                        levelComplete = true;
                        completeTimer = 0.0;
                    } else if (b.type == "coin") {
                        if (!coinAlreadyCollected(b)) {
                            collectedCoins = collectedCoins + [[b.x, b.y]];
                            score = score + 1;
                        }
                    }
                }
                hk = hk + 1;
            }

            // ---- fell off the world ----
            if (py > H + 200.0) {
                respawn();
            }
        } else {
            completeTimer = completeTimer + dt;
            if (completeTimer > 0.9) {
                if (levelIndex + 1 < len(levels)) {
                    loadLevel(levelIndex + 1);
                } else {
                    allDone = true;
                }
            }
        }
    }

    // ---- camera follows player, clamped so it doesn't show negative space ----
    camX = px - W / 2.0 + PLAYER_W / 2.0;
    if (camX < 0.0) { camX = 0.0; }

    // ---------- draw ----------
    pygame_clear(18, 18, 28);

    let di = 0;
    while (di < len(blocks)) {
        let b = blocks[di];
        let sx = b.x - camX;
        // simple cull: skip fully offscreen blocks
        if (sx + b.w >= 0.0 && sx <= W) {
            if (b.type == "coin") {
                if (!coinAlreadyCollected(b)) {
                    pygame_circle(sx + b.w / 2.0, b.y + b.h / 2.0, b.w / 2.0, b.color[0], b.color[1], b.color[2]);
                }
            } else {
                pygame_rect(sx, b.y, b.w, b.h, b.color[0], b.color[1], b.color[2]);
            }
        }
        di = di + 1;
    }

    if (!allDone) {
        // player
        pygame_rect(px - camX, py, PLAYER_W, PLAYER_H, 90, 170, 255);

        pygame_text(10, 10, levels[levelIndex].name, 230, 230, 230);
        pygame_text(10, 30, "Score: " + str(score), 200, 200, 200);
        pygame_text(10, 50, "A/D move  SPACE jump  R restart  ESC quit", 150, 150, 150);

        if (levelComplete) {
            pygame_text(W / 2.0 - 70.0, H / 2.0 - 10.0, "LEVEL COMPLETE!", 60, 255, 120);
        }
    } else {
        pygame_text(W / 2.0 - 90.0, H / 2.0 - 20.0, "ALL 26 LEVELS COMPLETE!", 60, 255, 120);
        pygame_text(W / 2.0 - 60.0, H / 2.0 + 10.0, "Final score: " + str(score), 220, 220, 220);
    }

    pygame_flip();
}

pygame_quit();
