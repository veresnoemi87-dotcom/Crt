    [moving(210.0, GROUND_Y - 20.0, 90.0, 20.0, "y", 180.0, 0.8)] +
    platform(400.0, GROUND_Y - 180.0, 90.0) +
    spikeRow(420.0, 1, 40.0, GROUND_Y - 180.0) +
    [moving(560.0, GROUND_Y - 180.0, 90.0, 20.0, "y", 220.0, 1.0)] +
    platform(760.0, GROUND_Y - 380.0, 90.0) +
    spikeRow(780.0, 1, 40.0, GROUND_Y - 380.0) +
    [moving(920.0, GROUND_Y - 380.0, 90.0, 20.0, "y", 180.0, 1.2)] +
    platform(1120.0, GROUND_Y - 560.0, 160.0) +
    [win(1180.0, GROUND_Y - 620.0, 40.0, 60.0)],
