    40.0, GROUND_Y - PLAYER_H)];

// ===== LEVEL 5: introduce bounce pad to reach a high ledge =====
levels = levels + [mkLevel("5: Bounce",
    groundRow(0.0, 400.0, GROUND_Y, 80.0) +
    [bounce(320.0, GROUND_Y - 20.0, 60.0, 20.0)] +
    platform(500.0, GROUND_Y - 260.0, 180.0) +
