// ============================================================
// 2D PLATFORMER -- 26 LEVELS
//   A / D or LEFT/RIGHT   - move
//   SPACE / UP            - jump
//   R                     - restart current level
//   ESC                   - quit
//
//   Block types:
//     wall    (white)   - solid ground/wall
//     spike   (red)     - kills you, respawn at level start
//     win     (green)   - flag, finishes the level
//     moving  (orange)  - platform that slides back and forth, carries you
//     bounce  (cyan)    - spring pad, launches you upward hard
//     coin    (yellow)  - collectible, adds to score, no gameplay effect
// ============================================================

let W = 1000;
let H = 600;
pygame_init(W, H, "CRT Platformer 2D");

// ---------- physics constants (pixels, seconds) ----------
let GRAVITY = 1800.0;
let MOVE_SPEED = 320.0;
let JUMP_SPEED = 620.0;
let BOUNCE_SPEED = 980.0;
let PLAYER_W = 28.0;
let PLAYER_H = 40.0;
let MAX_FALL = 1400.0;

// ---------- block constructors ----------
// every block: {x, y, w, h, type, color} in world pixel coords
// (x,y) is TOP-LEFT corner, matching pygame_rect's convention
fn mkBlock(x, y, w, h, type, color) {
    return { x: x, y: y, w: w, h: h, type: type, color: color };
}
fn wall(x, y, w, h)   { return mkBlock(x, y, w, h, "wall",   [235, 235, 235]); }
fn spike(x, y, w, h)  { return mkBlock(x, y, w, h, "spike",  [220, 40, 40]);   }
fn win(x, y, w, h)    { return mkBlock(x, y, w, h, "win",    [40, 220, 90]);   }
fn bounce(x, y, w, h) { return mkBlock(x, y, w, h, "bounce", [40, 210, 220]);  }
fn coin(x, y, w, h)   { return mkBlock(x, y, w, h, "coin",   [235, 210, 40]);  }
fn moving(x, y, w, h, axis, range, speed) {
    return {
        x: x, y: y, w: w, h: h, type: "moving", color: [230, 150, 30],
        homeX: x, homeY: y, axis: axis, range: range, speed: speed,
        phase: 0.0, prevX: x, prevY: y
    };
}

// ---------- reusable layout helpers ----------
// ground strip of solid wall blocks, one wide block from x0 to x1 at y
fn groundRow(x0, x1, y, thickness) {
    return [wall(x0, y, x1 - x0, thickness)];
}
// a floating platform
fn platform(x, y, w) {
    return [wall(x, y, w, 24.0)];
}
// a row of evenly spaced spikes sitting on top of a y-surface
fn spikeRow(x0, count, spacing, y) {
    let out = [];
    let i = 0;
    while (i < count) {
        out = out + [spike(x0 + i * spacing, y - 24.0, 26.0, 24.0)];
        i = i + 1;
    }
    return out;
}
// a set of ascending stair platforms
fn stairs(x0, y0, steps, stepW, stepH, dx, dy) {
    let out = [];
    let i = 0;
    while (i < steps) {
        out = out + [wall(x0 + i * dx, y0 - i * dy, stepW, stepH)];
        i = i + 1;
    }
    return out;
}

let GROUND_Y = 520.0;

// ---------- level list ----------
// each entry: { blocks: [...], spawn: [x, y], name: "..." }
let levels = [];

// ---- helper to build a level record ----
fn mkLevel(name, blocks, spawnX, spawnY) {
    return { name: name, blocks: blocks, spawn: [spawnX, spawnY] };
}

// ===== LEVEL 1: tutorial - flat ground, one gap, one coin, flag =====
levels = levels + [mkLevel("1: First Steps",
    groundRow(0.0, 900.0, GROUND_Y, 80.0) +
    [coin(400.0, GROUND_Y - 60.0, 20.0, 20.0)] +
    [win(830.0, GROUND_Y - 60.0, 40.0, 60.0)],
    40.0, GROUND_Y - PLAYER_H)];

// ===== LEVEL 2: introduce a gap you must jump =====
levels = levels + [mkLevel("2: Gap",
    groundRow(0.0, 350.0, GROUND_Y, 80.0) +
    groundRow(520.0, 950.0, GROUND_Y, 80.0) +
    [coin(430.0, GROUND_Y - 120.0, 20.0, 20.0)] +
    [win(880.0, GROUND_Y - 60.0, 40.0, 60.0)],
    40.0, GROUND_Y - PLAYER_H)];

// ===== LEVEL 3: introduce spikes on the ground =====
