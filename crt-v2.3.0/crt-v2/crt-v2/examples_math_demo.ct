// =====================================================================
// CRT MATH BUILTINS DEMO
// Run with:  crt run examples_math_demo.ct
//
// Constants (pi, e, tau) are called like zero-arg functions -- CRT has
// no notion of a global constant, so this keeps them consistent with
// every other builtin. Trig functions work in radians; deg()/rad()
// convert between radians and degrees.
// =====================================================================

print("== constants ==");
print(pi());              // 3.14159...
print(e());                // 2.71828...
print(tau());                // 6.28318...  (2*pi)

print("== trig (radians) ==");
print(sin(pi() / 2));     // 1
print(cos(0));             // 1
print(tan(pi() / 4));       // ~1

print("== inverse trig -> radians ==");
print(asin(1));            // pi/2
print(acos(1));             // 0
print(atan2(1, 1));          // pi/4

print("== hyperbolic ==");
print(sinh(0));            // 0
print(cosh(0));             // 1
print(tanh(0));              // 0

print("== powers, roots, logs ==");
print(sqrt(144));          // 12
print(pow(2, 10));          // 1024
print(exp(1));               // e
print(log(e()));              // 1
print(log(8, 2));              // 3  (log base 2 of 8)
print(log2(1024));              // 10
print(log10(1000));              // 3

print("== rounding & misc ==");
print(floor(3.9));         // 3
print(ceil(3.1));           // 4
print(round(3.14159, 2));    // 3.14
print(abs(-7));               // 7

print("== degrees <-> radians ==");
print(deg(pi()));          // 180
print(rad(180));            // pi

print("== a small worked example: circle area/circumference ==");
class Circle {
    fn new(radius) { self.r = radius; }
    fn area() { return pi() * self.r * self.r; }
    fn circumference() { return 2 * pi() * self.r; }
}
let c = Circle(3);
print(c.area());           // 9*pi
print(c.circumference());   // 6*pi
